="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex"><w:body><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:after="100"/><w:jc w:val="center"/></w:pPr><w:r><w:t xml:space="preserve">FMIS: Çok Çeşitli Kanaldan Veri Yakalama Mimarisi</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="200"/><w:jc w:val="center"/></w:pPr><w:r><w:t xml:space="preserve">Çiftçi-Merkezli ERP — Tüm Veri Türlerini Kabul Eden Platform</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="50"/></w:pPr><w:r><w:t xml:space="preserve">Belge Versiyonu: 1.0</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="50"/></w:pPr><w:r><w:t xml:space="preserve">Tarih: Ağustos 2026</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:t xml:space="preserve">Durum: Stratejik Mimari Tasarım</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="300"/></w:pPr><w:r><w:t xml:space="preserve">Amaç: IA Platformunun tüm veri türlerini (ses, görüntü, video, metin, sensörler) nasıl kabul ettiğini ve birleştirilmiş ERP sistemine işlediğini tanımlamak</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:after="100"/></w:pPr><w:r><w:t xml:space="preserve">Yönetici Özeti</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:t xml:space="preserve">Temel İlke: Çiftçiler tercih ettikleri yöntemle veri girer. Platform otomatik işler.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:t xml:space="preserve">IA Platform FMIS (Çiftlik Bilgi Yönetim Sistemi) omnichannel veri yakalama destekler:</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Ses: Komutlar, notlar, raporlar (STT + NLP)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Görüntüler: Faturalar, hastalık, kalite (OCR + Bilgisayar Görüşü)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Video: Tarla durumu, hasat, makine performansı (Eylem Tanıma)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Elle Giriş: Formlar, takvimler, listeler</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Yazılı: SMS, WhatsApp, E-posta, Telegram</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Sensörler: IoT, uydu, hava, drone, GPS</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">AR (Artırılmış Gerçeklik): Canlı tanı (hastalık, kalite)</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100" w:before="100"/></w:pPr><w:r><w:t xml:space="preserve">Tüm veriler → Akıllı İşleme Motoru → Standartlaştırılmış ERP Verileri → Modüller + Raporlar + Asistan</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="300"/></w:pPr><w:r><w:t xml:space="preserve">Sonuç: Çiftçiler bilgisayar açmadan tam bir ERP yönetebilir.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:after="100"/></w:pPr><w:r><w:t xml:space="preserve">1. VERİ GIRIŞ KANALLARI (7 Ana + 2 Premium)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="100"/></w:pPr><w:r><w:t xml:space="preserve">1.1 Sesli Veri Girdisi</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="50"/></w:pPr><w:r><w:t xml:space="preserve">Teknoloji:</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Konuşmayı Metne Dönüştürme (STT): Google Cloud Speech-to-Text, AWS Transcribe</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Doğal Dil İşleme (NLP): spaCy, Türkçe için BERT</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Niyet Tanıma: Komut, soru, bilgi, gözlem</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Varlık Çıkarma: Sayılar, kategoriler, tarihler, kişiler</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="50" w:before="100"/></w:pPr><w:r><w:t xml:space="preserve">Ses Giriş Türleri:</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading3"/><w:spacing w:after="50"/></w:pPr><w:r><w:t xml:space="preserve">A. Komut Girdisi</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="50"/></w:pPr><w:r><w:t xml:space="preserve">Çiftçi: &quot;Sulamayı başlat&quot;</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Niyet: Eylem</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Hedef: FMIS.Agro</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Sonuç: Sulama işi başlatıldı</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading3"/><w:spacing w:after="50" w:before="100"/></w:pPr><w:r><w:t xml:space="preserve">B. Veri Girdisi</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="50"/></w:pPr><w:r><w:t xml:space="preserve">Çiftçi: &quot;200 litre mazot, 50 litre gübre, 30 kg tohum&quot;</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Çıkarma: 200L → Mazot → Gider kategorisi</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Kategorize: Enerji, Beslenme, Tohumlar</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Sonuç: Depo güncellenmiş, gider kayıtları yapılmış</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading3"/><w:spacing w:after="50" w:before="100"/></w:pPr><w:r><w:t xml:space="preserve">C. Gözlem Günlüğü</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="50"/></w:pPr><w:r><w:t xml:space="preserve">Çiftçi: &quot;Parsel A&apos;da solüş ve sarılık görülüyor, diğer alanlardan daha kötü durumda&quot;</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">NLP: Hastalık belirtileri algılandı</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">AI Tanı: Çinko eksikliği %75, Fungal %40</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Veri: Ses kaydı arşivlendi (kanıt)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Sonuç: Monitor modülü uyarısı, uzman danışmanı öner</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="50" w:before="100"/></w:pPr><w:r><w:t xml:space="preserve">Ses Giriş Teknik Özellikleri:</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Dil: Türkçe (standart + diyalektler)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Gürültü İstisnası: Traktör motor gürültüsünde de çalışır</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Çevrimdışı Mod: Telefonunda lokal model (internet olmadan)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Sürekli Kaydedici: Arka planda açık kalabilir</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Ses Arşivi: Tüm kayıtlar saklanır (denetim, revizyon)</w:t></w:r></w:p><w:r><w:br w:type="page"/></w:r><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:after="100" w:before="200"/></w:pPr><w:r><w:t xml:space="preserve">Sonuç</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="50"/></w:pPr><w:r><w:t xml:space="preserve">FMIS Çok Çeşitli Veri Yakalama Mimarisi sağlar:</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Çiftçiler tercih ettikleri yöntemle veri girer</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Platform otomatik işler, kategorize eder, rapor eder</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml